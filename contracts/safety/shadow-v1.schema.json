        "signals": {
          "items": {
            "$ref": "#/$defs/SafetySignalV1"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Signals",
          "type": "array"
        },
        "snapshot_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "live",
            "replay",
            "synthetic"
          ],
          "title": "Source Kind",
          "type": "string"
