    "TaskProgressV1": {
      "additionalProperties": false,
      "properties": {
        "expected_step": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Expected Step",
          "type": "string"
        },
        "observed_step": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Observed Step",
          "type": "string"
        }
      },
      "required": [
        "expected_step",
        "observed_step"
      ],
      "title": "TaskProgressV1",
      "type": "object"
    }
