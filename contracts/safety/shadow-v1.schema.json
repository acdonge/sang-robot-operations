  "$id": "https://sang.local/contracts/safety/shadow-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "SANG command-free Unity safety Shadow Mode contract. The bundle documents three independently transported message types.",
  "properties": {
    "assessment": {
      "$ref": "#/$defs/SafetyAssessmentV1"
    },
    "policy": {
      "$ref": "#/$defs/SafetyPolicyV1"
    },
    "snapshot": {
      "$ref": "#/$defs/SafetySnapshotV1"
    }
  },
  "required": [
    "snapshot",
    "policy",
    "assessment"
  ],
  "title": "SafetyContractV1",
  "type": "object"
}
