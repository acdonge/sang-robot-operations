  "$id": "https://sang.local/contracts/orchestration/workflow-definition-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Vendor-neutral capability DAG with role cardinality and structured predicates.",
  "properties": {
    "roles": {
      "items": {
        "$ref": "#/$defs/WorkflowRoleV2"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Roles",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "action": "#/$defs/ActionStepV2",
            "barrier": "#/$defs/BarrierStepV2",
            "compensation": "#/$defs/CompensationStepV2",
            "conditional": "#/$defs/ConditionalStepV2",
            "human_approval": "#/$defs/HumanApprovalStepV2",
            "human_task": "#/$defs/HumanTaskStepV2",
            "wait_for_observation": "#/$defs/WaitForObservationStepV2"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ActionStepV2"
          },
          {
            "$ref": "#/$defs/WaitForObservationStepV2"
          },
          {
            "$ref": "#/$defs/BarrierStepV2"
          },
          {
            "$ref": "#/$defs/ConditionalStepV2"
          },
          {
            "$ref": "#/$defs/HumanApprovalStepV2"
          },
          {
            "$ref": "#/$defs/HumanTaskStepV2"
          },
          {
            "$ref": "#/$defs/CompensationStepV2"
          }
        ]
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "workflow_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
