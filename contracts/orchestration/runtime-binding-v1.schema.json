{
  "$defs": {
    "ManifestRefV1": {
      "additionalProperties": false,
      "properties": {
        "manifest_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Manifest Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "manifest_id",
        "version",
        "sha256"
      ],
      "title": "ManifestRefV1",
      "type": "object"
    },
    "RegistryRefV1": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "title": "RegistryRefV1",
      "type": "object"
    },
    "RoleBindingV1": {
      "additionalProperties": false,
      "properties": {
        "asset_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Asset Ids",
          "type": "array"
        },
        "role": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "asset_ids"
      ],
      "title": "RoleBindingV1",
      "type": "object"
    },
    "RuntimeAssetV1": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "calibration_refs": {
          "items": {
            "$ref": "#/$defs/RegistryRefV1"
          },
          "maxItems": 64,
          "title": "Calibration Refs",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "maxLength": 96,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "command_sink_present": {
          "default": false,
          "title": "Command Sink Present",
          "type": "boolean"
        },
        "commissioned_capabilities": {
          "items": {
            "maxLength": 96,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Commissioned Capabilities",
          "type": "array"
        },
        "connection_ref": {
          "$ref": "#/$defs/RegistryRefV1"
        },
        "coordinated_group_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegistryRefV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_ref": {
          "$ref": "#/$defs/ManifestRefV1"
        },
        "output_isolation_evidence_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegistryRefV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime_class": {
          "enum": [
            "physical",
            "simulation",
            "replay"
          ],
          "title": "Runtime Class",
          "type": "string"
        },
        "supported_modes": {
          "items": {
            "enum": [
              "OBSERVE_ONLY",
              "SIMULATION",
              "REPLAY",
              "SHADOW",
              "HIL",
              "PHYSICAL_AUTO",
              "PHYSICAL_TELEOP",
              "MAINTENANCE"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Supported Modes",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "runtime_class",
        "manifest_ref",
        "connection_ref",
        "capabilities",
        "supported_modes"
      ],
      "title": "RuntimeAssetV1",
      "type": "object"
    },
    "WorkflowRefV2": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "workflow_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "version"
      ],
      "title": "WorkflowRefV2",
      "type": "object"
    }
  },
  "$id": "https://sang.local/contracts/orchestration/runtime-binding-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable-per-Run capability and execution-mode binding.",
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/RuntimeAssetV1"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "binding_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Binding Id",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "OBSERVE_ONLY",
        "SIMULATION",
        "REPLAY",
        "SHADOW",
        "HIL",
        "PHYSICAL_AUTO",
        "PHYSICAL_TELEOP",
        "MAINTENANCE"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "role_bindings": {
      "items": {
        "$ref": "#/$defs/RoleBindingV1"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Role Bindings",
      "type": "array"
    },
    "run_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workflow_ref": {
      "$ref": "#/$defs/WorkflowRefV2"
    }
  },
  "required": [
    "binding_id",
    "run_id",
    "workflow_ref",
    "execution_mode",
    "assets",
    "role_bindings"
  ],
  "title": "RuntimeBindingV1",
  "type": "object"
}
