    "AssetManifestEvidenceRefV2": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "manifest_ref": {
          "$ref": "#/$defs/ManifestRefV1"
        }
      },
      "required": [
        "asset_id",
        "manifest_ref"
      ],
      "title": "AssetManifestEvidenceRefV2",
      "type": "object"
    },
    "ClockMeasurementV2": {
      "additionalProperties": false,
      "properties": {
        "monitor_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Monitor Id",
          "type": "string"
        },
        "offset_ms": {
          "title": "Offset Ms",
          "type": "number"
        },
        "reference_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Reference Id",
          "type": "string"
        },
        "sampled_at": {
          "format": "date-time",
          "title": "Sampled At",
          "type": "string"
        },
        "state": {
          "enum": [
            "synchronized",
            "degraded",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "uncertainty_ms": {
          "minimum": 0.0,
          "title": "Uncertainty Ms",
          "type": "number"
        }
      },
      "required": [
        "monitor_id",
        "reference_id",
        "sampled_at",
        "offset_ms",
        "uncertainty_ms",
        "state"
      ],
      "title": "ClockMeasurementV2",
      "type": "object"
    },
    "JsonValue": {},
    "ManifestRefV1": {
      "additionalProperties": false,
      "properties": {
        "manifest_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Manifest Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
