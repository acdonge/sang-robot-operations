      },
      "required": [
        "manifest_id",
        "version",
        "sha256"
      ],
      "title": "ManifestRefV1",
      "type": "object"
    },
    "RegistryRefV1": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "maxLength": 64,
