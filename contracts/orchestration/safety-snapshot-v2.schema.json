  "$id": "https://sang.local/contracts/orchestration/safety-snapshot-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Command-free, source-ordered safety evidence payload.",
  "properties": {
    "asset_ids": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Asset Ids",
      "type": "array"
    },
    "calibration_refs": {
      "items": {
        "$ref": "#/$defs/RegistryRefV1"
      },
      "maxItems": 128,
      "title": "Calibration Refs",
      "type": "array"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "clock": {
      "$ref": "#/$defs/ClockMeasurementV2"
    },
    "command_emitted": {
      "const": false,
      "default": false,
      "title": "Command Emitted",
      "type": "boolean"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 3,
        "type": "string"
      },
      "maxItems": 256,
      "title": "Evidence Refs",
      "type": "array"
    },
    "manifest_refs": {
      "items": {
        "$ref": "#/$defs/AssetManifestEvidenceRefV2"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Manifest Refs",
      "type": "array"
    },
    "policy_ref": {
      "$ref": "#/$defs/RegistryRefV1"
    },
    "producer_boot_id": {
      "format": "uuid",
      "title": "Producer Boot Id",
      "type": "string"
    },
    "producer_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "title": "Producer Id",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "run_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "separations": {
      "items": {
        "$ref": "#/$defs/SeparationObservationV2"
      },
      "maxItems": 512,
      "title": "Separations",
      "type": "array"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/SafetySignalV2"
      },
      "maxItems": 512,
      "title": "Signals",
      "type": "array"
    },
    "snapshot_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "workflow_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowStateEvidenceV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "zone_occupancies": {
      "items": {
        "$ref": "#/$defs/ZoneOccupancyV2"
      },
      "maxItems": 512,
      "title": "Zone Occupancies",
      "type": "array"
    },
    "zone_refs": {
      "items": {
        "$ref": "#/$defs/RegistryRefV1"
      },
      "maxItems": 128,
      "title": "Zone Refs",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "producer_id",
    "producer_boot_id",
    "sequence",
    "run_id",
    "captured_at",
    "received_at",
    "clock",
    "asset_ids",
    "manifest_refs",
    "policy_ref"
  ],
  "title": "SafetySnapshotV2",
  "type": "object"
}
