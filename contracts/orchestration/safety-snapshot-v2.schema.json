          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "object_id",
        "version",
        "sha256"
      ],
      "title": "RegistryRefV1",
      "type": "object"
    },
    "SafetySignalV2": {
      "additionalProperties": false,
